# Copy to .env and replace every CHANGE_ME before starting infra or the API.
# .env is gitignored. This file is the only env file that belongs in git.

# App
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
WEB_URL=http://127.0.0.1:5173
API_URL=http://127.0.0.1:4000

# PostgreSQL 16 (control plane) and the Stalwart database created on first boot
POSTGRES_DB=mrrokesh_mail
POSTGRES_USER=mrrokesh
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://mrrokesh:CHANGE_ME@127.0.0.1:5432/mrrokesh_mail
STALWART_DB_PASSWORD=CHANGE_ME

# memory runs the API without Postgres. postgres uses APP_DATABASE_URL after db:migrate.
CONTROL_STORE=memory
# db:migrate sets this password on the mrrokesh_app role. The API must use that role so RLS applies.
APP_DB_PASSWORD=CHANGE_ME_APP
APP_DATABASE_URL=postgresql://mrrokesh_app:CHANGE_ME_APP@127.0.0.1:5432/mrrokesh_mail
# mock keeps mail provisioning in process. http posts stubs to STALWART_API_URL.
MAIL_PLANE=mock
SUPPLIER_STATE_CODE=29
MX_HOST=mx1.mrrokesh.mail
SPF_INCLUDE=spf.mrrokesh.mail

# Redis 7
REDIS_PASSWORD=CHANGE_ME
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379

# Auth and encryption. Generate peppers and JWT secrets with: openssl rand -base64 48
# DATA_ENCRYPTION_KEY_V1 must decode to exactly 32 bytes: openssl rand -base64 32
# PASSWORD_PEPPER is the active pepper. Keep older versions until every user has signed in again.
JWT_ACCESS_SECRET=CHANGE_ME_MIN_32_BYTES
JWT_REFRESH_SECRET=CHANGE_ME_MIN_32_BYTES
PASSWORD_PEPPER=CHANGE_ME_32_PLUS_RANDOM_BYTES
PASSWORD_PEPPER_V1=CHANGE_ME_32_PLUS_RANDOM_BYTES
PASSWORD_PEPPER_ACTIVE_VERSION=1
DATA_ENCRYPTION_KEY_V1=CHANGE_ME_SEPARATE_32_BYTE_AES_256_GCM_KEY

# Stalwart Community (unmodified). Admin token comes from the setup wizard, not from this example.
STALWART_API_URL=http://127.0.0.1:8080
STALWART_ADMIN_TOKEN=CHANGE_ME

# Billing. Razorpay is the launch gateway. Stripe is optional until a global account exists.
RAZORPAY_KEY_ID=rzp_test_CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Observability
SENTRY_DSN=
